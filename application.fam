# For details & more options, see documentation/AppManifests.md in firmware repo

DFC_CDEFINES = [
    ("DFC_FIRMWARE_BUILD", "1"),
    ("DFC_CRYPTO_BACKEND_TINY", "1"),
    ("TC_ENABLE_AES", "1"),
    ("TC_AES_ENABLE_ECB", "1"),
    ("TC_AES_ENABLE_CBC", "1"),
    ("TC_AES_ENABLE_CTR", "0"),
    ("TC_ENABLE_DES", "1"),
    ("TC_DES_ENABLE_ECB", "1"),
    ("TC_DES_ENABLE_CBC", "1"),
    ("TC_DES_ENABLE_CTR", "0"),
    ("TC_DES_ENABLE_TDES", "1"),
    ("TC_DES_SBOX_MODE", "TC_DES_SBOX_MODE_FAST"),
    ("TC_ENABLE_SHA256", "0"),
    ("DFC_BUILD_ROLE", "DFC_ROLE_TARGET"),
    ("DFC_ENABLE_TEXT_CODEC", "1"),
    ("DFC_BUILD_PROFILE", "DFC_PROFILE_FULL_EV3"),
    ("DFC_ENABLE_STORAGE_8K", "0"),
    # Debug instrumentation (set to 0 for release). DFC_DEBUG_APDU logs RX/TX
    # frames + EV2 state; DFC_DEBUG_SAVE dumps credential fields before a save;
    # DFC_DEBUG_VALIDATE records the rejected validate-model line for save errors.
    # WARNING: DFC_DEBUG_APDU=1 writes to USB SYNCHRONOUSLY inside the NFC radio
    # callback. Each log line costs ~5 ms; a chained write (WRDUMP + decrypted-clear
    # dump) pushed the response to ~343 ms, far past the ATS FWT (TB1=0x81 -> FWI=8
    # -> ~77 ms), so a real reader (multi-application) saw the exchange degrade and sent a
    # truncated follow-up command -> 91 1E and a half-enrolled badge. KEEP THIS AT 0
    # for any live-reader run; only enable for local-sim/host debugging where there
    # is no FWT deadline. See memory dfc-multiapp-enrollment-progress.
    ("DFC_DEBUG_APDU", "0"),
    # Disable EV2/EV3 features an access-control (multi-application) credential never uses, to
    # reclaim heap + code so a 16-application credential and the text codec plugin
    # both fit in the (tighter) 2.0.0 FAP heap. The multi-application captures only ever use
    # standard data files, AES/EV2 auth, ChangeKey, and SetConfiguration. Re-enable
    # any of these if a future credential needs it.
    ("DFC_ENABLE_VIRTUAL_CARD", "0"),
    ("DFC_ENABLE_PROXIMITY_CHECK", "1"),
    ("DFC_ENABLE_DELEGATED_APPLICATIONS", "0"),
    ("DFC_ENABLE_STATIC_SIGNATURE", "0"),
    ("DFC_ENABLE_SDM", "0"),
    ("DFC_ENABLE_TRANSACTION_MAC", "0"),
    # Re-enabled: the multi-application EV2 enrollment sends SetConfiguration option 0x05
    # (APPLICATION_CAPABILITIES), whose handler is gated by this flag. Disabling
    # it made that command return PARAMETER_ERROR (91 9E) and the reader aborted.
    # The text-codec OOM is now solved by loading the plugin before the file read
    # (dfc_credential_file_load), so this feature fits again.
    ("DFC_ENABLE_TRANSACTION_TIMER", "1"),
    ("DFC_MAX_APPS", "16"),
    ("DFC_MAX_FILES", "18"),
    ("DFC_MAX_KEYS", "8"),
    ("DFC_FILE_POOL_SIZE", "2560"),
    ("DFC_KEY_POOL_SIZE", "1024"),
    ("DFC_MAX_FILE_DATA", "1024"),
]

App(
    appid="dfc",  # Must be unique
    name="DFC",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="dfc_app",
    stack_size=10 * 1024,
    fap_category="NFC",
    # Optional values
    fap_version="1.1.1",
    fap_icon="dfc.png",  # 10x10 1-bit PNG
    fap_description="DFC: reader/emulator for compatible NFC credentials",
    fap_author="CinderSocket",
    fap_weburl="https://github.com/cindersocket/dfc-flipper",
    fap_icon_assets="images",  # Image assets to compile for this application
    fap_file_assets="files",
    cdefines=DFC_CDEFINES,
    fap_private_libs=[
        Lib(
            name="core",
            fap_include_paths=["src", "port"],
            cflags=["-Wno-redundant-decls", "-Wno-sign-compare"],
            sources=[
                "src/aes_cmac.c",
                "src/des_cmac.c",
                "src/dfc_[!t]*.c",
                "src/dfc_transaction_mac.c",
            ],
            cincludes=["lib/tiny-crypto-c/src"],
        ),
        Lib(
            name="tiny-crypto-c",
            fap_include_paths=["src"],
            sources=[
                "src/aes.c",
                "src/aes_modes.c",
                "src/block_modes.c",
                "src/common.c",
                "src/des.c",
                "src/des_modes.c",
            ],
        ),
    ],
    # The recursive glob would otherwise build these sources twice.
    sources=["*.c", "*.cpp", "!lib", "!tests", "!text_plugin"],
)

App(
    appid="dfc_text_import",
    apptype=FlipperAppType.PLUGIN,
    entry_point="dfc_text_codec_ep",
    requires=["dfc"],
    fal_embedded=True,
    cdefines=DFC_CDEFINES + [("DFC_TEXT_IMPORT_PLUGIN", "1")],
    sources=["text_plugin/*.c"],
    fap_private_libs=[
        Lib(
            name="text_import",
            fap_include_paths=["../core/src", "../core/port"],
            sources=["*.c"],
        ),
    ],
)

App(
    appid="dfc_text_export",
    apptype=FlipperAppType.PLUGIN,
    entry_point="dfc_text_codec_ep",
    requires=["dfc"],
    fal_embedded=True,
    cdefines=DFC_CDEFINES + [("DFC_TEXT_EXPORT_PLUGIN", "1")],
    sources=["text_plugin/*.c"],
    fap_private_libs=[
        Lib(
            name="text_export",
            fap_include_paths=["../core/src", "../core/port"],
            sources=["*.c"],
        ),
    ],
)
